# =========================================================================
# TASKFLOW - Environment Variables Configuration Template
# Copy this file to .env before starting the application in production/docker:
#   cp .env.example .env
# =========================================================================

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow_secret

# Spring Application Profile
# Options: dev (uses embedded H2 memory db with Postgres mode), prod (uses PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# JWT Authentication
# Replace with a cryptographically secure 256-bit or 512-bit hex key in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Apache Kafka Configuration (Semester 3 Microservices)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TASK_EVENTS=task-events
KAFKA_ENABLED=true

# OAuth2 Provider Credentials (Optional)
OAUTH_CLIENT_ID=your-google-or-github-client-id
OAUTH_CLIENT_SECRET=your-google-or-github-client-secret

# Frontend Configuration
PORT=8080
VITE_API_URL=/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Demo Pre-seeded Accounts (For Testing & Evaluation)
# Admin:   admin@taskflow.com / admin123  (Role: ADMIN)
# Manager: manager@taskflow.com / manager123 (Role: MANAGER)
# Member:  member@taskflow.com / member123 (Role: MEMBER)
